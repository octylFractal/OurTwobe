{
    "presets": [
        [
            "@babel/preset-env",
            {
                "modules": false
            }
        ],
        [
            "@babel/preset-react",
            {
                "runtime": "automatic"
            }
        ]
    ],
    "plugins": [
        [
            "babel-plugin-polyfill-corejs3",
            {
                "method": "usage-global",
                "version": "3.51"
            }
        ],
        "@babel/plugin-transform-runtime"
    ]
}
